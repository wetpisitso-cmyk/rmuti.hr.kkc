# Cloudflare R2: set these ONLY after creating a PRIVATE R2 bucket and a
# bucket-scoped Object Read & Write API token. Do not put these in GitHub.
# While R2_ENABLED=false
# Keep false until production cleanup is approved and retention guard removed.
R2_CLEANUP_READY=false, new uploads continue using Supabase Storage.
R2_ENABLED=false
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_32_CHARACTER_ACCOUNT_ID
